# Copia este archivo a `.env` y rellena los valores. `.env` está en
# .gitignore: las credenciales nunca se suben al repositorio.

# --- Alpaca (solo con --broker alpaca) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Sin ALPACA_BASE_URL se usa el entorno PAPER de Alpaca (dinero ficticio).
# Dinero real: https://api.alpaca.markets  (requiere además la línea de abajo)
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Habilitación consciente del dinero real. Déjalo comentado en paper.
# TRADING_AGENT_LIVE=YES

# --- Bloomberg (solo con provider: bloomberg) ---
# BLOOMBERG_HOST=localhost
# BLOOMBERG_PORT=8194
